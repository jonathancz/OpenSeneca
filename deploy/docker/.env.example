# Optional, non-secret settings for docker-compose.yml. Copy to
# deploy/docker/.env (git-ignored) or export them in your shell.
# Secrets do NOT go here: put them in the file named by OPENSENECA_SECRETS_FILE
# (see secrets.env.example).

# Env file with OPENJARVIS_API_KEY, DISCORD_BOT_TOKEN, ... (outside the repo).
# OPENSENECA_SECRETS_FILE=${HOME}/.config/openseneca/secrets.env

# Ollama model the server uses; pull it first:
#   docker compose -f deploy/docker/docker-compose.yml exec ollama ollama pull <model>
# OPENSENECA_MODEL=qwen3.5:4b

# Optional extras baked into the jarvis image (comma separated pyproject extras).
# OPENSENECA_EXTRAS=server,channel-discord,speech,voice

# Host ports (always bound to 127.0.0.1).
# OPENSENECA_PORT=8000
# OLLAMA_PORT=11434
