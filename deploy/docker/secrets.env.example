# Template for the stack's secrets file. Copy it OUTSIDE the repo and fill it in:
#   mkdir -p ~/.config/openseneca
#   install -m 600 deploy/docker/secrets.env.example ~/.config/openseneca/secrets.env
# docker-compose.yml loads ~/.config/openseneca/secrets.env by default
# (override with OPENSENECA_SECRETS_FILE). Never commit real values.

# Required (left empty here on purpose). The container binds 0.0.0.0, so the server refuses to start
# without a key. Generate one with:
#   python3 -c "import secrets; print('oj_sk_' + secrets.token_urlsafe(32))"
# Clients send:  Authorization: Bearer <key>
OPENJARVIS_API_KEY=

# Optional. Discord bot token for the Discord channel.
# DISCORD_BOT_TOKEN=replace-with-your-discord-bot-token
# Discord user ids allowed to talk to the bot (comma separated). The first one
# is the owner the bot DMs proactively. Empty means the bot answers nobody.
# DISCORD_ALLOWED_USER_IDS=replace-with-your-discord-user-id

# Optional. Unsplash Access Key for the rotating hero photo in the web UI.
# Server side only; never sent to the browser.
# UNSPLASH_ACCESS_KEY=

# Optional. Cloud providers, used only when set.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
